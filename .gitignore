.DS_Store
.wrangler/
gear-images/wrangler.toml
gear-maintenance/wrangler.toml

# Local environment files may contain credentials. Keep documented examples.
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# instructions/ is reserved for local working material that stays out of the
# repository. Maintained project documentation lives in docs/.
instructions/*

# Never track local databases or their journals.
*.sqlite
*.sqlite-*
*.db
*.db-*
# Local hockey source footage and generated clips never belong in this public repo.
felix-holtgrieve/**/*.mp4
felix-holtgrieve/**/*.mov
felix-holtgrieve/**/*.webm
.Rproj.user
