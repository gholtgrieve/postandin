.DS_Store
.wrangler/

# Local environment files may contain credentials. Keep documented examples.
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# instructions/ holds working material that stays out of the repo (drafts,
# audit reports, backlog notes, .docx files). The technical spec and active
# Gear Exchange plan are tracked alongside the code they describe. Note the pattern must be `instructions/*`, not `instructions/`:
# git will not re-include a file whose parent directory is itself excluded,
# so negating a path inside an excluded directory silently does nothing.
instructions/*
!instructions/postandin-technical-spec.md
!instructions/gear-exchange-plan.md
!instructions/gear-storage.md

# Never track local databases or their journals.
*.sqlite
*.sqlite-*
*.db
*.db-*
!instructions/gear-management.md
