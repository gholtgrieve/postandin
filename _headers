/*.js
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache

# There is no build step, so Cloudflare Pages serves every tracked file as a
# static asset — including instructions/postandin-technical-spec.md, which
# became tracked on 2026-07-22. Keep internal docs out of search results.
# X-Robots-Tag (not robots.txt Disallow) for the same reason the unfinished
# HTML pages use a noindex meta tag: a blocked crawler never reads the
# directive. See Search Visibility & Routing in the technical spec.
/instructions/*
  X-Robots-Tag: noindex, nofollow

# Machine-readable team schedule baselines support the private travel-page
# monitor and should not appear in search results.
/data/*
  X-Robots-Tag: noindex, nofollow

# Direct-link team travel page. Keep it crawlable so robots can read noindex,
# but require revalidation because logistics change frequently.
/mets-16aa-travel/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# Direct-link unofficial team stats page. Keep it crawlable so robots can read
# noindex, but require revalidation when season totals change.
/mets-16aa-stats/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# Public Gear Exchange pages are indexable but change as listings are posted.
/gear/*
  Cache-Control: no-cache

# Keep the owner review assets out of search results on every Pages hostname.
/gear/owner*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

/lib/gear-exchange.mjs
  Content-Type: application/javascript
  Cache-Control: no-cache

/gear/gear.mjs
  Content-Type: application/javascript

/gear/owner.mjs
  Content-Type: application/javascript

/gear/production-api.mjs
  Content-Type: application/javascript

/gear/production-turnstile.mjs
  Content-Type: application/javascript

/lib/gear-image-provider-id.mjs
  Content-Type: application/javascript
  Cache-Control: no-cache

/lib/gear-origins.mjs
  Content-Type: application/javascript
  Cache-Control: no-cache
