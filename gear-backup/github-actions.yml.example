name: Gear records backup

# Source-only template. Do not copy this file into .github/workflows or add the
# schedule until the owner explicitly authorizes provider setup and operation.
on:
  workflow_dispatch:
  # schedule:
  #   - cron: "0 8 * * *"

permissions:
  contents: read

jobs:
  backup:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: "24"
      - name: Install age
        run: sudo apt-get update && sudo apt-get install --yes age
      - name: Export, encrypt, upload and read back Gear records
        env:
          GEAR_BACKUP_CF_ACCOUNT_ID: ${{ secrets.GEAR_BACKUP_CF_ACCOUNT_ID }}
          GEAR_BACKUP_D1_DATABASE_ID: ${{ secrets.GEAR_BACKUP_D1_DATABASE_ID }}
          GEAR_BACKUP_CF_API_TOKEN: ${{ secrets.GEAR_BACKUP_CF_API_TOKEN }}
          GEAR_BACKUP_B2_KEY_ID: ${{ secrets.GEAR_BACKUP_B2_KEY_ID }}
          GEAR_BACKUP_B2_APP_KEY: ${{ secrets.GEAR_BACKUP_B2_APP_KEY }}
          GEAR_BACKUP_B2_BUCKET_ID: ${{ secrets.GEAR_BACKUP_B2_BUCKET_ID }}
          GEAR_BACKUP_AGE_RECIPIENT: ${{ secrets.GEAR_BACKUP_AGE_RECIPIENT }}
        run: node scripts/gear/lean-cloud-backup.mjs
