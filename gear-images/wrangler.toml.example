name = "postandin-gear-images"
main = "src/index.js"
compatibility_date = "2026-07-01"
workers_dev = false
preview_urls = false

[observability]
enabled = true

[images]
binding = "IMAGES"

# This Worker is service-binding-only. Do not add routes or deploy it until the
# complete Gear project is approved for deployment. The Pages project will bind
# it as GEAR_IMAGES after both services are provisioned and reviewed.
